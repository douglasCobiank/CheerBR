# ===================================================================
# CheerBR - Exemplo de variaveis de ambiente
# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA commite o ".env" real (ele ja esta no .gitignore).
# ===================================================================

# --- PostgreSQL local (usado pelo docker-compose.yml na raiz) ---
POSTGRES_USER=cheerbr
POSTGRES_PASSWORD=cheerbr_password_troque_me
POSTGRES_DB=cheerbr
POSTGRES_PORT=5432

# --- Connection string usada pelo backend .NET ---
# Formato Npgsql. A senha e o host devem bater com as vars acima.
# `dotnet ef` (AppDbContextFactory) e a API (Program.cs) leem esta var primeiro.
# Em producao, NAO incluir "Include Error Detail=true" (vaza SQL/parametros em 500s).
DATABASE_URL=Host=localhost;Port=5432;Database=cheerbr;Username=cheerbr;Password=cheerbr_password_troque_me

# --- Backend (.NET) ---
# Onde o backend grava os logos das equipes. Monte um volume persistente aqui.
UPLOADS_PATH=/var/lib/cheerbr/uploads
# Separado por virgulas. Vazio = AllowAnyOrigin (nao recomendado em producao).
CORS_ALLOWED_ORIGINS=https://cheerbr-1.onrender.com,http://localhost:5173

# Chave de administrador (header X-API-Key) necessaria para mutacoes
# (POST/PUT/DELETE/logo). Sem essa env var definida em producao, todas as
# operacoes de escrita sao recusadas (fail-safe).
# Use uma string aleatoria de no minimo 32 chars (ex: `openssl rand -hex 32`).
ADMIN_API_KEY=troque-por-uma-chave-forte-de-32-bytes-ou-mais

# --- Cloudflare R2 (object storage para logos) ---
# Se configurado, os logos sao enviados para o bucket R2 em vez de disco local.
# Se ausente, usa UPLOADS_PATH (disco local) como fallback.
# R2 free tier: 10 GB armazenamento, egress gratuito.
# Crie um bucket no dashboard do Cloudflare R2 e gere um token de API.
# R2_ACCOUNT_ID=abc123def456
# R2_ACCESS_KEY_ID=seu-access-key
# R2_SECRET_ACCESS_KEY=seu-secret
# R2_BUCKET_NAME=cheerbr-logos
# URL publica do bucket (ativar "Public Access" no bucket R2 ou usar dominio customizado)
# R2_PUBLIC_URL=https://logos.cheerbr.com

# --- Frontend (Vite) ---
# URL base da API REST consumida por src/lib/api.ts
VITE_API_URL=http://localhost:10000/api
